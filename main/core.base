model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Table
    filters:
      not:
        - file.name.contains("README")
        - file.folder == "templates"
        - file.ext == "base"
    order:
      - file.name
      - topic
      - class
      - created
    columnSize:
      file.name: 289
      note.class: 133
