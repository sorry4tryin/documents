			"height":60
		},
		{
			"id":"56c36b23d3a7fef5",
			"type":"text",
			"text":"use latex",
			"styleAttributes":{"textAlign":"center"},
			"x":-840,
			"y":490,
			"width":260,
			"height":60
		},
		{
			"id":"27fceb1641313141",
			"type":"text",
			"text":"used for essays and long notes. though with knowing this i will be using obsidian as the main note taking application, to provide effiency",
			"styleAttributes":{"textAlign":"center"},
			"x":-1240,
			"y":405,
			"width":260,
			"height":230
		},
		{
			"id":"4cb73d9722974af4",
