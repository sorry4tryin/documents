			"text":"neovim",
			"styleAttributes":{"textAlign":"center"},
			"x":680,
			"y":380,
			"width":125,
			"height":60
		},
		{
			"id":"f10d7d256766a72a",
			"type":"text",
			"text":"learn keybinds",
			"styleAttributes":{"textAlign":"center"},
			"x":900,
			"y":260,
			"width":260,
			"height":60
		},
		{
